[Unit]
Description=Quant Trade System
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/YOUR_USER/work_dir/quant_trade_sys
ExecStart=/home/YOUR_USER/venv/bin/python -m jobs.run_all --lan
Environment=PYTHONUNBUFFERED=1
Environment=PATH=/home/YOUR_USER/venv/bin:/usr/local/bin:/usr/bin:/bin
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
