{
  "schema_version": 1,
  "enabled": true,
  "model_id": "finance_multi_asset_transformer",
  "role": "primary_quant_decision_candidate",
  "history_period": "10y",
  "risk_free_benchmark": "BIL",
  "horizons": [
    63,
    126,
    252
  ],
  "lookback": 252,
  "observation_frequency": "W-FRI",
  "maximum_training_symbols": 100,
  "universe_policy": {
    "exclude_tactical_products_from_long_horizon": true,
    "tactical_product_symbols": [
      "BITI",
      "CHAU",
      "CWEB",
      "NVD",
      "NVDL",
      "NVDS",
      "SDOW",
      "SETH",
      "SH",
      "SOXL",
      "SPXS",
      "SQQQ",
      "TQQQ",
      "TSLS",
      "TSLZ",
      "UVIX",
      "YANG",
      "YINN"
    ]
  },
  "architecture": {
    "d_model": 64,
    "temporal_layers": 2,
    "cross_asset_layers": 2,
    "attention_heads": 4,
    "feedforward_multiplier": 4,
    "dropout": 0.1,
    "patch_size": 10,
    "patch_stride": 5,
    "expert_count": 4,
    "top_k_experts": 2
  },
  "training": {
    "epochs": 30,
    "batch_size": 8,
    "learning_rate": 0.0003,
    "weight_decay": 0.0001,
    "device": "auto",
    "pretraining_epochs": 20,
    "pretraining_validation_fraction": 0.15,
    "pretraining_minimum_epochs": 5,
    "pretraining_early_stopping_patience": 4,
    "pretraining_early_stopping_min_delta": 0.0001,
    "walk_forward_epochs": 5,
    "retrain_interval_days": 30,
    "initialization_policy": "auto_long_horizon"
  },
  "artifacts": {
    "checkpoint_path": "trained_models/finance_multi_asset_transformer.pt",
    "production_checkpoint_path": "trained_models/finance_multi_asset_transformer_production.pt",
    "bootstrap_checkpoint_path": "model_artifacts/bootstrap/finance_multi_asset_transformer.pt",
    "bootstrap_manifest_path": "model_artifacts/bootstrap/manifest.json",
    "pretraining_checkpoint_path": "trained_models/finance_multi_asset_transformer_pretrain.pt",
    "snapshot_path": "storage/state/multi_horizon_snapshot.json",
    "validation_path": "storage/state/multi_horizon_validation.json",
    "panel_path": "storage/state/multi_horizon_panel.parquet"
  },
  "promotion": {
    "automatic": false,
    "minimum_walk_forward_folds": 3,
    "require_pretraining_ablation": true,
    "require_positive_top3_excess_return": true
  },
  "traditional_ml_policy": {
    "production_enabled": false,
    "allow_only_after_positive_ablation": true
  }
}
